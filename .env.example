# ============================================================
#  onlinecolorpage.com — environment variables
#  Copy to .env.local for local dev, or set as App Settings in Azure.
# ============================================================

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://onlinecolorpage.com
NEXT_PUBLIC_SITE_NAME=Online Color Page

# ---------- Supabase (Project Settings -> API Keys) ----------
# New projects issue sb_publishable_... / sb_secret_... keys. Older ones issue
# anon / service_role JWTs that start with eyJ. Either works - the variable
# names below are unchanged.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Server-only. NEVER expose to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ---------- Cloudflare R2 (S3-compatible API) ----------
# Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=onlinecolorpage
# Optional. If the bucket has a public custom domain or r2.dev subdomain,
# files are served straight from it. Leave empty to stream through /api/file/*.
R2_PUBLIC_BASE_URL=

# ---------- Ads ----------
# ca-pub-XXXXXXXXXXXXXXXX — leave empty to disable all ad slots
NEXT_PUBLIC_ADSENSE_CLIENT=

# ---------- Analytics (optional) ----------
NEXT_PUBLIC_GA_ID=

# ---------- Admin ----------
# First Supabase Auth user with this email is auto-promoted to admin on login.
ADMIN_BOOTSTRAP_EMAIL=you@example.com
